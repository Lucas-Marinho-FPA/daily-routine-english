[
 {
  "key": "362e96ad",
  "text": "Morning! I don't think we've met. I'm Priya, and I work in the design team.",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "962b0809",
  "text": "Hi, Priya. Nice to meet you. I'm Daniel. It's my first day here, actually.",
  "kind": "sentence",
  "voice": "bm_lewis"
 },
 {
  "key": "9f2eacbf",
  "text": "Oh, welcome! Where are you from, Daniel?",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "c5dc57e7",
  "text": "I'm from Leeds, but I've been living in Bristol for a couple of years.",
  "kind": "sentence",
  "voice": "bm_lewis"
 },
 {
  "key": "9c635be3",
  "text": "Lovely. And what do you do?",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "b0ce936c",
  "text": "I'm a software developer. I'll be working on the new booking app.",
  "kind": "sentence",
  "voice": "bm_lewis"
 },
 {
  "key": "f8091223",
  "text": "Great! Oh, here's Ruth. Ruth, have you met Daniel? He's just joined the team.",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "16695b6d",
  "text": "Hello, Daniel. Pleased to meet you. How are you finding it so far?",
  "kind": "sentence",
  "voice": "bf_lily"
 },
 {
  "key": "7a04ecdb",
  "text": "Pleased to meet you, too. So far, so good. Everyone's been really friendly.",
  "kind": "sentence",
  "voice": "bm_lewis"
 },
 {
  "key": "345e43a8",
  "text": "Glad to hear it. If you need anything, just let me know.",
  "kind": "sentence",
  "voice": "bf_lily"
 },
 {
  "key": "990d0934",
  "text": "Thanks very much. I really appreciate it.",
  "kind": "sentence",
  "voice": "bm_lewis"
 },
 {
  "key": "c48ccff7",
  "text": "Shall we grab a coffee later? I can introduce you to the rest of the team.",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "0a07366e",
  "text": "That sounds great. See you later!",
  "kind": "sentence",
  "voice": "bm_lewis"
 },
 {
  "key": "38603f7a",
  "text": "Hi, everyone. This is my friend Leo. He's just moved here from Manchester.",
  "kind": "sentence",
  "voice": "bm_daniel"
 },
 {
  "key": "d51312d7",
  "text": "Hi! Nice to meet you all.",
  "kind": "sentence",
  "voice": "bm_george"
 },
 {
  "key": "3508a590",
  "text": "Nice to meet you, Leo. Have you joined a club yet?",
  "kind": "sentence",
  "voice": "bf_alice"
 },
 {
  "key": "2daaf8b8",
  "text": "Not yet, but I'd like to. I usually run at the weekend.",
  "kind": "sentence",
  "voice": "bm_george"
 },
 {
  "key": "2340d29b",
  "text": "Brilliant. Our running club meets every Saturday morning, so you should come along.",
  "kind": "sentence",
  "voice": "bf_alice"
 },
 {
  "key": "14c26ed8",
  "text": "Thanks, I will. I'm really looking forward to it.",
  "kind": "sentence",
  "voice": "bm_george"
 },
 {
  "key": "36a55d92",
  "text": "What do you fancy doing tonight? There's a new comedy on at the cinema.",
  "kind": "sentence",
  "voice": "bm_george"
 },
 {
  "key": "e3db2fb0",
  "text": "Hmm, I'm not really into comedies. I prefer something more exciting.",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "44188905",
  "text": "Really? Comedies are my favourite. What kind of films do you like, then?",
  "kind": "sentence",
  "voice": "bm_george"
 },
 {
  "key": "b6b9eec4",
  "text": "I'm a huge fan of thrillers, but I can't stand films with a predictable ending.",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "fa30c973",
  "text": "Fair enough. So what do you think of the new spy film?",
  "kind": "sentence",
  "voice": "bm_george"
 },
 {
  "key": "8b8c7f06",
  "text": "I've heard it's brilliant. Actually, a couple of friends saw it last week.",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "b89938d7",
  "text": "To be honest, I'm not keen on spy films. They're often far too long.",
  "kind": "sentence",
  "voice": "bm_george"
 },
 {
  "key": "c706798d",
  "text": "That's true. Personally, I don't mind long films if the story's good.",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "97edc99c",
  "text": "How about a compromise? We watch your thriller, and I choose the takeaway.",
