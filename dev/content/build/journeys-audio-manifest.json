 },
 {
  "key": "cd7f8111",
  "text": "I'd love a curry. I'm absolutely starving.",
  "kind": "sentence",
  "voice": "bm_george"
 },
 {
  "key": "f9854535",
  "text": "Me too. Shall we order now? Just let me know what you want.",
  "kind": "sentence",
  "voice": "bf_isabella"
 },
 {
  "key": "04744535",
  "text": "I really like this café. The coffee's excellent.",
  "kind": "sentence",
  "voice": "bf_alice"
 },
 {
  "key": "f46f4288",
  "text": "I agree, but to be honest, I'm not so sure about the music. It's a bit loud.",
  "kind": "sentence",
  "voice": "bm_daniel"
 },
 {
  "key": "192bca48",
  "text": "Really? I quite like it. I find it relaxing.",
