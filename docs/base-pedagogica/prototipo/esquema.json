{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base-pedagogica/esquema/0.1.0",
  "title": "Base Pedagógica Mestra — esquema (PROTÓTIPO 0.1.0, em revisão)",
  "$defs": {
    "id": { "type": "string", "pattern": "^(FON|ORI|VOC|EXP|GRA|TXT|SEG|DIA|PER|RSP|ATV|EXE|CTX|PSG|REL|DEC|DIV)-[0-9]{6}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "camada": { "enum": ["publica", "privada"] },
    "status": { "enum": ["proposto", "ativo", "retirado"] },
    "jornada": { "enum": ["jor:daily-routine", "jor:conversation-practice"] },
    "habilidade": { "enum": ["hab:reading", "hab:writing", "hab:listening", "hab:speaking", "hab:vocabulary", "hab:grammar", "hab:functional"] },
    "evidencia": {
      "type": "object", "required": ["ori"],
      "properties": { "ori": { "$ref": "#/$defs/id" }, "campo": { "type": "string" } }
    },
    "origemInfo": {
      "description": "toda informação traduzida, explicada ou enriquecida diz de onde veio: um ORI, uma DEC ou autoria do projeto",
      "type": "object",
      "properties": { "ori": { "$ref": "#/$defs/id" }, "decisao": { "$ref": "#/$defs/id" }, "autoria": { "const": "projeto" } },
      "anyOf": [{ "required": ["ori"] }, { "required": ["decisao"] }, { "required": ["autoria"] }]
    },
    "historico": {
      "type": "array",
      "items": { "type": "object", "required": ["versao", "data", "mudanca"],
        "properties": { "versao": { "type": "integer" }, "data": { "type": "string" }, "mudanca": { "type": "string" }, "motivo": { "type": "string" }, "decisao": { "$ref": "#/$defs/id" } } }
    },
    "unidadeBase": {
      "type": "object",
      "required": ["id", "tipo", "camada", "status", "versao", "historico", "evidencias"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "camada": { "$ref": "#/$defs/camada" }, "status": { "$ref": "#/$defs/status" },
        "versao": { "type": "integer", "minimum": 1 }, "historico": { "$ref": "#/$defs/historico" },
        "jornadas": { "type": "array", "items": { "$ref": "#/$defs/jornada" } },
        "evidencias": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencia" } }
      }
    }
  },
  "tipos": {
    "FON": {
      "type": "object", "required": ["id", "tipo", "camada", "natureza"],
      "properties": {
        "natureza": { "enum": ["autoria", "pessoal", "terceiros", "licenciada", "derivada"] },
        "arquivo": { "type": "string", "description": "só na camada pública; fontes privadas não têm caminho na pública" },
        "versao": { "type": "string" }, "hash_arquivo": { "$ref": "#/$defs/hash" }, "licenca": { "type": "string" }
      }
    },
    "ORI": {
      "type": "object", "required": ["id", "tipo", "camada", "fonte", "local", "conteudo", "hash"],
      "properties": {
        "fonte": { "$ref": "#/$defs/id" }, "versao_fonte": { "type": "string" }, "local": { "type": "string" },
        "id_original": { "type": ["string", "null"] }, "tipo_original": { "type": "string" },
        "conteudo": {}, "hash": { "$ref": "#/$defs/hash" }, "extraido_em": { "type": "string" }, "extrator": { "type": "string" }
      }
    },
    "VOC": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["forma"],
      "properties": { "forma": { "type": "string" },
        "traducoes": { "type": "array", "items": { "type": "object", "required": ["texto"], "properties": { "texto": { "type": "string" }, "contexto": { "type": "string" }, "origem": { "$ref": "#/$defs/origemInfo" } } } },
        "classe_gramatical": { "type": ["object", "null"] }, "pronuncia": { "type": "array" },
        "classificacoes_origem": { "type": "array", "items": { "type": "object", "required": ["categoria", "ori"] } } } },
    "EXP": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["forma"],
      "properties": { "forma": { "type": "string" }, "subtipo": { "type": ["string", "null"], "enum": ["phrasal", "collocation", "funcional", "conector", "tempo", "chunk", null] },
        "traducoes": { "type": "array" }, "funcao_comunicativa": { "type": ["string", "null"] }, "classificacoes_origem": { "type": "array" } } },
    "GRA": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["estrutura"] },
    "TXT": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["original"] },
    "SEG": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["original"] },
    "DIA": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["falas"] },
    "PER": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["enunciado"] },
    "RSP": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["pergunta", "original"] },
    "ATV": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["perguntas"],
      "properties": { "habilidades": { "type": "array", "items": { "type": "object", "required": ["habilidade", "origem"], "properties": { "habilidade": { "$ref": "#/$defs/habilidade" }, "origem": { "$ref": "#/$defs/origemInfo" } } } } } },
    "EXE": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }] },
    "CTX": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }] },
    "PSG": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }] },
    "REL": { "type": "object", "required": ["id", "tipo", "de", "relacao", "para", "status", "evidencias"],
      "properties": { "relacao": { "enum": ["duplicado_de", "variante_de", "semelhante_a", "equivalente_a", "contextualiza", "aparece_em", "prerequisito_de", "relacionada_a"] },
        "status": { "enum": ["proposta", "confirmada"] }, "decisao": { "$ref": "#/$defs/id" } } },
    "DEC": { "type": "object", "required": ["id", "tipo", "data", "decisao", "justificativa", "aprovada_por"] },
    "DIV": { "type": "object", "required": ["id", "tipo", "assunto", "versoes", "status"],
      "properties": { "versoes": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["valor", "ori"] } }, "status": { "enum": ["aberta", "resolvida"] } } }
  }
}
