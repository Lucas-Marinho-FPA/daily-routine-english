{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base-pedagogica/esquema/2.2.0",
  "title": "Base Pedagógica — esquema 2.2.0 (base única pública, 2026-11-09; DIV anulada; DEC com efeitos; subtipo phrasal_preposicional)",
  "description": "Cada registro é validado por tipos[<tipo>]. Campos não listados são permitidos (extensão aditiva); os listados são verificados. Normativo: docs/base-pedagogica/modelo-de-dados.md.",
  "$defs": {
    "id": { "type": "string", "pattern": "^(FON|ORI|VOC|EXP|GRA|TXT|SEG|DIA|PER|RSP|ATV|EXE|CTX|PSG|REL|DEC|DIV)-[0-9]{6}$" },
    "idOri": { "type": "string", "pattern": "^ORI-[0-9]{6}$" },
    "idDec": { "type": "string", "pattern": "^DEC-[0-9]{6}$" },
    "idsDe": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "data": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "enum": ["proposto", "ativo", "retirado"] },
    "jornada": { "enum": ["jor:daily-routine", "jor:conversation-practice"] },
    "habilidade": { "enum": ["hab:reading", "hab:writing", "hab:listening", "hab:speaking", "hab:vocabulary", "hab:grammar", "hab:functional"] },
    "lacuna": { "enum": ["sem_contexto_de_texto", "sem_traducao", "sem_resposta_modelo", "fonte_pendente_de_conferencia", "outra"] },
    "evidencia": {
      "type": "object", "required": ["ori"],
      "properties": { "ori": { "$ref": "#/$defs/idOri" }, "campo": { "type": "string" } }
    },
    "origemInfo": {
      "description": "toda informação traduzida, explicada ou enriquecida diz de onde veio: um ORI, uma DEC ou autoria do projeto",
      "type": "object",
      "properties": { "ori": { "$ref": "#/$defs/idOri" }, "campo": { "type": "string" }, "decisao": { "$ref": "#/$defs/idDec" }, "autoria": { "const": "projeto" } },
      "anyOf": [{ "required": ["ori"] }, { "required": ["decisao"] }, { "required": ["autoria"] }]
    },
    "textoComOrigem": {
      "type": "object", "required": ["texto", "origem"],
      "properties": { "texto": { "type": "string" }, "contexto": { "type": "string" }, "origem": { "$ref": "#/$defs/origemInfo" } }
    },
    "valorComOrigem": {
      "type": "object", "required": ["valor", "origem"],
      "properties": { "origem": { "$ref": "#/$defs/origemInfo" } }
    },
    "listaComOrigem": { "type": "array", "items": { "$ref": "#/$defs/valorComOrigem" } },
    "classificacaoOrigem": {
      "type": "object", "required": ["categoria", "subtipo", "ori"],
      "properties": { "categoria": { "type": "string" }, "subtipo": { "$ref": "#/$defs/subtipo" }, "ori": { "$ref": "#/$defs/idOri" } }
    },
    "subtipo": { "enum": ["phrasal", "phrasal_preposicional", "collocation", "funcional", "conector", "tempo", "chunk", null] },
    "historico": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["versao", "data", "mudanca"],
        "properties": { "versao": { "type": "integer", "minimum": 1 }, "data": { "$ref": "#/$defs/data" }, "mudanca": { "type": "string" }, "motivo": { "type": "string" }, "decisao": { "$ref": "#/$defs/idDec" } } }
    },
    "unidadeBase": {
      "type": "object",
      "required": ["id", "tipo", "status", "versao", "historico", "evidencias"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "status": { "$ref": "#/$defs/status" },
        "versao": { "type": "integer", "minimum": 1 }, "historico": { "$ref": "#/$defs/historico" },
        "jornadas": { "type": "array", "items": { "$ref": "#/$defs/jornada" } },
        "evidencias": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencia" } },
        "traducoes": { "type": "array", "items": { "$ref": "#/$defs/textoComOrigem" } },
        "explicacoes": { "type": "array", "items": { "$ref": "#/$defs/textoComOrigem" } },
        "classificacoes_origem": { "type": "array", "items": { "$ref": "#/$defs/classificacaoOrigem" } },
        "niveis_origem": { "$ref": "#/$defs/listaComOrigem" },
        "atributos_origem": { "type": "array", "items": { "type": "object", "required": ["campo", "valor", "origem"], "properties": { "campo": { "type": "string" }, "origem": { "$ref": "#/$defs/origemInfo" } } } },
        "divergencias": { "type": "array", "items": { "type": "string", "pattern": "^DIV-[0-9]{6}$" } },
        "lacunas": { "type": "array", "items": { "$ref": "#/$defs/lacuna" } },
        "revisoes": { "type": "array", "items": { "$ref": "#/$defs/evidencia" } },
        "personagens": { "type": "array", "items": { "type": "string", "pattern": "^PSG-[0-9]{6}$" } }
      }
    }
  },
  "tipos": {
    "FON": {
      "type": "object", "required": ["id", "tipo", "codigo", "titulo", "natureza", "distribuicao", "conferencia"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "tipo": { "const": "FON" }, "codigo": { "type": "string" }, "titulo": { "type": "string" },
        "natureza": { "enum": ["autoria", "derivada", "licenciada", "terceiros"] },
        "distribuicao": { "enum": ["integral", "somente_referencia"], "description": "somente_referencia: material sem licença de redistribuição — registrado com identificação e licença, sem conteúdo" },
        "arquivo": { "type": "string" }, "versao": { "type": "string" }, "hash_arquivo": { "$ref": "#/$defs/hash" },
        "licenca": { "type": "string" }, "observacao": { "type": "string" },
        "conferencia": { "enum": ["pendente", "em_andamento", "concluida"] }
      }
    },
    "ORI": {
      "type": "object", "required": ["id", "tipo", "fonte", "versao_fonte", "local", "conteudo", "hash", "extraido_em", "extrator"],
      "properties": {
        "id": { "$ref": "#/$defs/idOri" }, "tipo": { "const": "ORI" },
        "fonte": { "type": "string", "pattern": "^FON-[0-9]{6}$" }, "versao_fonte": { "type": "string" }, "local": { "type": "string" },
        "conteudo": {}, "hash": { "$ref": "#/$defs/hash" }, "extraido_em": { "$ref": "#/$defs/data" }, "extrator": { "type": "string" }
      }
    },
    "VOC": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["forma"],
      "properties": { "tipo": { "const": "VOC" }, "forma": { "type": "string" },
        "pronuncia": { "$ref": "#/$defs/listaComOrigem" }, "variantes": { "$ref": "#/$defs/listaComOrigem" },
        "formas_verbais": { "$ref": "#/$defs/listaComOrigem" }, "exemplos": { "$ref": "#/$defs/idsDe" }, "erros_frequentes": { "type": "array", "items": { "$ref": "#/$defs/evidencia" } } } },
    "EXP": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["forma", "subtipo"],
      "properties": { "tipo": { "const": "EXP" }, "forma": { "type": "string" }, "subtipo": { "$ref": "#/$defs/subtipo" },
        "pronuncia": { "$ref": "#/$defs/listaComOrigem" }, "variantes": { "$ref": "#/$defs/listaComOrigem" },
        "formas_verbais": { "$ref": "#/$defs/listaComOrigem" }, "exemplos": { "$ref": "#/$defs/idsDe" }, "erros_frequentes": { "type": "array", "items": { "$ref": "#/$defs/evidencia" } } } },
    "GRA": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["estrutura"], "properties": { "tipo": { "const": "GRA" }, "estrutura": { "type": "string" } } },
    "TXT": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["segmentos"],
      "properties": { "tipo": { "const": "TXT" }, "segmentos": { "$ref": "#/$defs/idsDe" }, "dialogos": { "$ref": "#/$defs/idsDe" } } },
    "SEG": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["original", "texto"],
      "properties": { "tipo": { "const": "SEG" }, "original": { "type": "string" }, "texto": { "type": "string", "pattern": "^TXT-[0-9]{6}$" }, "contextos": { "$ref": "#/$defs/idsDe" } } },
    "DIA": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["falas"], "properties": { "tipo": { "const": "DIA" }, "falas": { "$ref": "#/$defs/idsDe" } } },
    "PER": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["enunciado"], "properties": { "tipo": { "const": "PER" }, "enunciado": { "type": "string" } } },
    "RSP": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["pergunta", "original"],
      "properties": { "tipo": { "const": "RSP" }, "pergunta": { "type": "string", "pattern": "^PER-[0-9]{6}$" }, "original": { "type": "string" },
        "criterios": { "$ref": "#/$defs/listaComOrigem" } } },
    "ATV": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["perguntas"],
      "properties": { "tipo": { "const": "ATV" }, "perguntas": { "$ref": "#/$defs/idsDe" }, "respostas": { "$ref": "#/$defs/idsDe" },
        "perguntas_abertas": { "type": "array", "items": { "type": "object", "required": ["pergunta", "origem"], "properties": { "pergunta": { "type": "string", "pattern": "^PER-[0-9]{6}$" }, "origem": { "$ref": "#/$defs/origemInfo" } } } },
        "habilidades": { "type": "array", "items": { "type": "object", "required": ["habilidade", "origem"], "properties": { "habilidade": { "$ref": "#/$defs/habilidade" }, "origem": { "$ref": "#/$defs/origemInfo" } } } } } },
    "EXE": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["itens"], "properties": { "tipo": { "const": "EXE" }, "itens": { "type": "array", "items": { "$ref": "#/$defs/evidencia" } } } },
    "CTX": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["codigo"], "properties": { "tipo": { "const": "CTX" }, "codigo": { "type": "string" } } },
    "PSG": { "allOf": [{ "$ref": "#/$defs/unidadeBase" }], "required": ["codigo"], "properties": { "tipo": { "const": "PSG" }, "codigo": { "type": "string" } } },
    "REL": { "type": "object", "required": ["id", "tipo", "de", "relacao", "para", "status", "evidencias"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "tipo": { "const": "REL" }, "de": { "$ref": "#/$defs/id" }, "para": { "$ref": "#/$defs/id" },
        "relacao": { "enum": ["duplicado_de", "variante_de", "semelhante_a", "equivalente_a", "contextualiza", "aparece_em", "prerequisito_de", "relacionada_a"] },
        "status": { "enum": ["proposta", "confirmada"] }, "decisao": { "$ref": "#/$defs/idDec" },
        "evidencias": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencia" } } } },
    "DEC": { "type": "object", "required": ["id", "tipo", "data", "decisao", "justificativa", "status", "aprovada_por"],
      "properties": { "id": { "$ref": "#/$defs/idDec" }, "tipo": { "const": "DEC" }, "data": { "$ref": "#/$defs/data" },
        "status": { "enum": ["proposta", "aprovada", "revogada"] }, "evidencias": { "type": "array", "items": { "$ref": "#/$defs/evidencia" } },
        "efeitos": { "type": "array", "items": { "type": "object", "required": ["unidade", "campo", "valor"], "properties": { "unidade": { "$ref": "#/$defs/id" }, "campo": { "type": "string" }, "explicacao": { "type": "string" } } } } } },
    "DIV": { "type": "object", "required": ["id", "tipo", "unidade", "campo", "assunto", "versoes", "status"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "tipo": { "const": "DIV" }, "unidade": { "$ref": "#/$defs/id" }, "campo": { "type": "string" },
        "versoes": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["valor", "ori"], "properties": { "ori": { "$ref": "#/$defs/idOri" } } } },
        "status": { "enum": ["aberta", "resolvida", "anulada"] }, "decisao": { "$ref": "#/$defs/idDec" }, "motivo": { "type": "string" } } }
  }
}
